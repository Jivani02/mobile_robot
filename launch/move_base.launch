<launch>
    <rosparam file="$(find mobile_robot)/config/costmap_common_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find mobile_robot)/config/costmap_common_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find mobile_robot)/config/global_costmap_params.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find mobile_robot)/config/local_costmap_params.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find mobile_robot)/config/base_local_planner_params.yaml" command="load" ns="move_base" />
    
    <node pkg="move_base" type="move_base" name="move_base" output="screen">
        <param name="base_local_planner" value="base_local_planner/TrajectoryPlannerROS" />
        <param name="global_costmap/robot_base_frame" value="body1" />
        <param name="local_costmap/robot_base_frame" value="body1" />
        <param name="global_costmap/global_frame" value="map" />
    </node>
    
    <node pkg="amcl" type="amcl" name="amcl" output="screen">
        <param name="base_frame_id" value="body1" />
        <param name="odom_frame_id" value="odom" />
        <param name="global_frame_id" value="map" />
    </node>
    
</launch>
